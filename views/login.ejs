
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fighter Jets Login</title>
    <link rel="stylesheet" type="text/css" href="/StyleSheets/Login.css">
</head>
<body>
    <div class="welcome-message">Welcome to Fighter Jets History!</div>
    <div class="fighter-image">
        <img src="https://th.bing.com/th/id/R.0598e46461f2645e51f28ff8af21c9f4?rik=seFfC0Y46fJ6Xg&riu=http%3a%2f%2fupload.wikimedia.org%2fwikipedia%2fcommons%2fc%2fc9%2fF-16_June_2008.jpg&ehk=RvI7pilvJEZ48gVtixklQ9huylFfQwXCiHalCE8fmkQ%3d&risl=1&pid=ImgRaw&r=0" alt="F-16 Fighter Jet">
    </div>
    <div class="container">
        <div class="login-form">
            <h2>Login</h2>
            <form id="loginForm">
                <label for="username">Username:</label>
                <input type="text" id="username" name="username" required>
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required>
                <button type="submit">Login</button>
                <a href="/register" id="signup-link">Signup</a>
                <a href="/registplane" id="addplane-link">AddPlane</a>
            </form>
        </div>
    </div>
    <div class="fighter-image-right">
        <img src="https://www.digitalcombatsimulator.com/upload/iblock/76e/Screen_181102_122735.jpg" alt="MiG-29 Fighter Jet">
    </div>

    <script>
        var username = "";
        var password ="";
        var flag = 0;
        document.getElementById("loginForm").addEventListener("submit", function(event) {
            event.preventDefault();
             username = document.getElementById("username").value;
             password = document.getElementById("password").value;
             if(username == "" || password == "")
        {
            window.location.href = "/login";
            alert("Please enter username and password");
            flag = 1;
        }
        else{flag = 0;}
            if(flag == 0)
            {
               
            
          
                window.location.href = "/Welcome";
            
        }
            
        
            
        });
        document.getElementById("signup-link").addEventListener("click", function(event) 
        {
            
        });
 
        document.getElementById("addplane-link").addEventListener("click", function(event) 
        {
             
        });
        
        
        
    </script>
</body>
</html>
