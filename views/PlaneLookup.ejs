<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aircraft Registration Form</title>
    <link rel="stylesheet" type="text/css" href="/StyleSheets/PlaneLKP.css">
</head>
<body style="background-color: beige;">
    
    
    <div>
        <h1 style="text-align: center;">Aircraft Lookup </h1>
        <form action="/LookUp" method="post" id="LookUpForm">
            <label for="aircraftName">Aircraft Name:</label>
            <input type="text" id="aircraftName" name="aircraftName" required>
            <br>
            <label for="countryName">Country Name:</label>
            <select id="countryName" name="countryName" required>
                <option value="USA">USA</option>
                <option value="Russia">Russia</option>
            </select>
            <br>
            <input type="submit" value="Search">
        </form>
    </div>
    <div>
        <% var Information = "Default"; %>
        <p>
            
            Information: <%= Information %>
        </p>
    </div>
    <script>
        
        document.getElementById("LookUpForm").addEventListener("submit", function(event) {
            event.preventDefault();
            const AirCName = document.getElementById("aircraftName").value;
            const CountryName = document.getElementById("countryName").value;

         
            });
    </script>
</body>
</html>